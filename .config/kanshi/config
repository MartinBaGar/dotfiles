output "Dell Inc. DELL G2422HS 5998XJ3" {
    alias $monitor
}

output "LG Display 0x06E2 Unknown" {
    alias $laptop
}

# Position must be :
# 1st_laptop-logical-positoion / scale + 1
# example for :
# left  - 1920x1080, scale 1.3
# right - 1920x1080, scale 1.1
# position = 1920 / 1.3 + 1
# position = 1477
profile docked {
    output $monitor enable scale 1.1 position 1281,0 
    output $laptop enable scale 1.5 position 0,0
}

profile undocked {
    output $laptop enable scale 1.2 position 0,0
}

profile gaming {
    output $monitor enable scale 1.0 position 1281,0 
    output $laptop enable scale 1.5 position 0,0
}
