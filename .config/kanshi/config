output HDMI-A-1 {
    alias $monitor
}

output eDP-1 {
    alias $laptop
}

# Position must be :
# 1st_laptop-logical-positoion / scale + 1
# example for :
# left  - 1920x1080, scale 1.3
# right - 1920x1080, scale 1.1
# position = 1920 / 1.3 + 1
# position = 1477

profile docked {
    output $monitor enable scale 1.3
    output $laptop enable scale 1.5
}

profile undocked {
    output $laptop enable scale 1.0 position 0,0
}

profile just-monitor {
    output $monitor enable scale 1.4 position 0,0
}
