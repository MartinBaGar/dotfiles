config-notification {
    disable-failed
}

gestures {
    hot-corners {
        off
    }
}

input {
    keyboard {
        xkb {
  	    // layout "fr"

        // For example:
        // layout "us,ru"
        // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"

        }
        numlock
    }
}

output "HDMI-A-2" {
    scale 1.1
}

layout {
    // Set gaps around windows in logical pixels.
    gaps 6
    struts {
        left 6
        right 6
        top -6
        bottom 0
    }

    background-color "transparent"
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        off
        width 4
        active-color   "#808080"      // Medium gray
        inactive-color "#505050"      // Dark gray
    }

    border {
        off

        width 2
        inactive-color   "#707070"      // Neutral gray
        active-color "#d0d0d0"      // Light gray
        urgent-color   "#cc4444"      // Softer red
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

workspace "navigation" {
    open-on-output "HDMI-A-1"
    }
workspace "code" {
    open-on-output "HDMI-A-1"
    }
workspace "chat" {
    open-on-output "HDMI-A-1"
    }
workspace "lecture" {
    open-on-output "HDMI-A-1"
    }
workspace "visualisation" {
    open-on-output "HDMI-A-1"
    layout {
        gaps 0
        struts {
            left 0
            right 0
            bottom 0
            top -4
        }
    preset-column-widths {
        proportion 0.7
        proportion 0.3
    }
    }
    }

overview {
    workspace-shadow {
        off
    }
}

animations {
    off
}

spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"
spawn-at-startup "waybar"
spawn-at-startup "kanshi"
environment {
  XDG_CURRENT_DESKTOP "niri"
  QT_QPA_PLATFORM "wayland;xcb"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  SAL_USE_VCLPLUGIN "qt5"
  QT_QPA_PLATFORMTHEME "qt5ct"
  QT_QPA_PLATFORMTHEME_QT6 "gtk3"
  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
  TERMINAL "kitty"
}
hotkey-overlay {
    skip-at-startup
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

window-rule {
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}
window-rule {
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^steam$"#
    match app-id=r#"^xdg-desktop-portal$"#
    open-floating false
}
window-rule {
    match app-id="kitty"
    draw-border-with-background false
}

window-rule {
    match is-active=false
    opacity 0.8
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background true
}

window-rule {
    match app-id="Rocket.Chat"
    match title="Discord*"
    match title="KeePassXC"
    open-on-workspace "chat"
}

window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"# title="^Unlock Database - KeePassXC$"
    open-focused true
}

window-rule {
    match app-id="thunderbird_thunderbird"
    open-on-workspace "chat"
}

window-rule {
    match title="Brave"
    open-on-workspace "navigation"
}

window-rule {
    match app-id="com.gabm.satty"
    match title="satty"
    open-floating true
}

window-rule {
    match app-id="at.yrlf.wl_mirror"
    open-fullscreen true
}

window-rule {
    match app-id="Zotero"
    match app-id="com.github.th_ch.youtube_music"
    open-maximized true
    open-on-workspace "lecture"
}

window-rule {
    match app-id="btop-float"
    default-column-width { proportion 0.9; }
    default-window-height { proportion 0.9; }
    open-floating true
    geometry-corner-radius 0
}

window-rule {
    match title="Age of empires"
}

window-rule {
    match app-id="org.pymol.PyMOL" title="PyMOL"
    default-column-width { proportion 0.7; }
    default-column-display "normal"
    open-on-workspace "Visualisation"
    geometry-corner-radius 0
}

window-rule {
    match app-id="org.pymol.PyMOL" title="External GUI"
    default-column-width { proportion 0.3; }
    open-floating false
    open-on-workspace "Visualisation"
    geometry-corner-radius 0
}

window-rule {
    match app-id="guitarpro.exe"
    open-floating false
    geometry-corner-radius 0
}

window-rule {
    match app-id="^spleen$"
    match title="^spleen$"
    open-floating true
    geometry-corner-radius 12
    clip-to-geometry true
    
    // background-effect {
        // off
        // blur true
        // noise 0.05
        // saturation 3
    // }
        focus-ring {
        on
        width 4
        active-color "#000000"
    }
}

binds {
    // === System & Overview ===
    Mod+D { spawn "niri" "msg" "action" "toggle-overview"; }
    Mod+Tab repeat=false { toggle-overview; }
    Mod+Shift+Colon { show-hotkey-overlay; }

    // === Application Launchers / Scripts execution ===
    Mod+T hotkey-overlay-title="Open Terminal" { spawn "kitty"; }
    Mod+Space hotkey-overlay-title="Application Launcher" {
       spawn "emacs" "--name" "spleen" "--title" "spleen" "--init-directory" "~/.config/emacs-vanilla/var/spleen-standalone";
    }
    Mod+Alt+Space { spawn-sh "~/scripts/bash/niri-window-switcher.sh"; }
    Mod+Alt+O { spawn-sh "~/scripts/bash/fuzzel-file-actions.sh"; }
    Mod+Alt+V { spawn-sh "~/scripts/bash/fuzzel-clipboard.sh"; }
    Mod+Alt+P { spawn-sh "~/scripts/bash/fuzzel-powermenu.sh"; }
    Mod+Alt+S { spawn-sh "~/scripts/bash/fuzzel-kanshi-profiles.sh"; }
    Mod+Shift+S { spawn-sh "~/scripts/bash/fuzzel-screenshot.sh"; }
    Mod+Alt+W { spawn-sh "~/scripts/bash/reload_waybar.sh"; }
    Mod+Alt+K { spawn "niri" "msg" "action" "switch-layout" "next"; }
    Mod+Alt+T { spawn-sh "~/scripts/bash/niri_switch_theme.sh"; }
    Mod+Alt+D { spawn "~/.local/bin/waypaper" "--random"; }

    Mod+E {spawn-sh "emacs --init-directory ~/.config/emacs-vanilla/";}
    Mod+N { spawn-sh " emacsclient --alternate-editor= --reuse-frame -n --socket-name=utils -e '(toggle-named-frame \"Doom Notes\")' "; }
    Mod+M { spawn-sh "~/scripts/bash/mails.sh"; }

    // === Security ===
     Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn "swaylock" "-l" "--color" "000000";
        // spawn-sh "dunstctl set-paused true && swaylock -l --color 000000 && dunstctl set-paused false";
    }
    Ctrl+Alt+Delete hotkey-overlay-title="Task Manager" {
        spawn "kitty" "-o" "window_padding_width=0" "--class" "btop-float" "btop" "--preset" "1" ; }
    Mod+Shift+E { quit; }

    // === Audio Controls ===
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%+"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"
    }
    XF86AudioMute allow-when-locked=true {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
    }

    // === Window Management ===
    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    // === Focus Navigation ===
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // === Window Movement ===
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    // === Column Navigation ===
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+M repeat=false { spawn-sh "wl-mirror $(niri msg --json focused-output | jq -r .name)"; }

    // === Monitor Navigation ===
    Mod+Ctrl+Left  { focus-monitor-left; }
    // Mod+Ctrl+Down  { focus-monitor-down; }
    // Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    // === Move to Monitor ===
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // === Workspace Navigation ===
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Ctrl+Up   { move-column-to-workspace-up; }
    // Mod+Ctrl+U         { move-column-to-workspace-down; }
    // Mod+Ctrl+I         { move-column-to-workspace-up; }

    // === Move Workspaces ===
    Mod+Shift+Page_Down { move-workspace-to-monitor-next; }
    Mod+Shift+Page_Up   { move-workspace-to-monitor-previous; }
    // Mod+Shift+U         { move-workspace-down; }
    // Mod+Shift+I         { move-workspace-up; }

    // === Mouse Wheel Navigation ===
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // === Numbered Workspaces ===
    Mod+Ampersand { focus-workspace "navigation"; }
    Mod+Eacute { focus-workspace "code"; }
    Mod+Quotedbl { focus-workspace "chat"; }
    Mod+Apostrophe { focus-workspace "lecture"; }
    Mod+Parenleft { focus-workspace "Visualisation"; }

    // === Move to Numbered Workspaces ===
    Mod+Shift+Ampersand { move-column-to-workspace "navigation"; }
    Mod+Shift+Eacute { move-column-to-workspace "code"; }
    Mod+Shift+Quotedbl { move-column-to-workspace "chat"; }
    Mod+Shift+Apostrophe { move-column-to-workspace "lecture"; }
    Mod+Shift+Parenleft { move-column-to-workspace "Visualisation"; }

    // === Column Management ===
    Mod+Y  { consume-or-expel-window-left; }
    Mod+O { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }

    // === Sizing & Layout ===
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    // === Manual Sizing ===
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // === System Controls ===
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // MediaPlayer
    XF86AudioPrev allow-when-locked=true {
     spawn "playerctl" "previous";
    }
    XF86AudioNext allow-when-locked=true {
     spawn "playerctl" "next";
    }
    XF86AudioPlay allow-when-locked=true {
     spawn "playerctl" "play-pause";
    }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "s" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "s" "5%-"; }
}

layer-rule {
    // match namespace="^launcher$"
    // match namespace="^fuzzel$"

    // background-effect {
        // blur true
    // }
    geometry-corner-radius 20
}
